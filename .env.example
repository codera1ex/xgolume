# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# WEATHER_API_KEY: OpenWeatherMap API key, used by /api/weather in server.ts.
# Get one free at https://openweathermap.org/api
# If left blank, the app falls back to mock weather data automatically.
WEATHER_API_KEY=""

# --- Supabase (used by the frontend, in src/lib/supabase.ts) ---
# Get these from your Supabase project: Settings -> API
# The anon/publishable key is safe to expose in frontend code by design.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# --- Geoapify (used by /api/nearby-live in server.ts) ---
# Get these free at https://myprojects.geoapify.com
GEOAPIFY_GEOCODING_API_KEY=""
GEOAPIFY_PLACES_API_KEY=""
# Not used yet — reserved for a future real trip-route feature on the map.
GEOAPIFY_ROUTING_API_KEY=""
